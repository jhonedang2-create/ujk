// (주)대천우정김 통합 스키마
// 개발: SQLite / 운영: PostgreSQL 로 provider 만 바꾸면 됩니다.
// (enum·배열·Json 타입을 쓰지 않아 두 DB 모두 호환됩니다)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // 운영 전환 시: "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// 회원 / 인증 (NextAuth v5)
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  loginId       String?   @unique // 직원·관리자 로그인 아이디 (예: admin)
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String? // 이메일 가입 시에만 사용 (bcrypt)

  phone     String?
  /**
   * 숫자만 남긴 번호 — 문자 발송 대상 조회에 씁니다 (하이픈 유무로 매칭이 어긋나는 것 방지)
   */
  phoneNorm String  @default("")
  birth     String?
  gender    String? // "M" | "F"
  role      String  @default("USER") // USER | STAFF | MANAGER | ADMIN
  status    String  @default("ACTIVE") // "ACTIVE" | "DORMANT" | "BANNED"

  // 직원 계정용 — 비어 있으면 role 의 기본 권한을 따릅니다
  permissions String    @default("")
  position    String    @default("") // 직책 (예: 물류팀장)
  memo        String    @default("")
  lastLoginAt DateTime?
  createdById String? // 이 계정을 만든 관리자
  point       Int       @default(0)
  grade       String    @default("BASIC") // BASIC | SILVER | GOLD | VIP
  provider    String? // "naver" | "kakao" | "credentials"

  agreeMarketing  Boolean   @default(false)
  agreeSms        Boolean   @default(false)
  termsAgreedAt   DateTime?
  privacyAgreedAt DateTime?
  termsVersion    String    @default("")
  privacyVersion  String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
  cartItems CartItem[]
  reviews   Review[]
  inquiries Inquiry[]
  points    PointLog[]

  @@index([role])
  @@index([createdAt])
  @@index([phoneNorm])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String  @default("기본 배송지")
  receiver  String
  phone     String
  zipcode   String
  address1  String
  address2  String  @default("")
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PointLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // +적립 / -사용
  balance   Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// 상품
// ─────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  parentId    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  imageUrl    String?
  description String  @default("")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime @default(now())

  @@index([parentId])
}

model Product {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  categoryId  String
  summary     String @default("") // 한 줄 소개
  description String @default("") // 상세 HTML

  price     Int // 판매가
  listPrice Int     @default(0) // 정상가(할인 전). 0 이면 할인 없음
  cost      Int     @default(0) // 원가(관리자만)
  stock     Int     @default(0)
  sku       String? @unique

  origin String @default("국내산") // 원산지
  maker  String @default("(주)대천우정김")
  unit   String @default("") // 예: "10g x 12봉"
  weight Int    @default(0) // g 단위 (배송비 계산용)

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false) // 메인 노출
  isBest     Boolean @default(false)
  isNew      Boolean @default(false)
  soldCount  Int     @default(0)
  viewCount  Int     @default(0)

  // 식품 표시사항 (식품등의 표시·광고에 관한 법률 대응)
  foodType      String @default("") // 식품유형
  ingredients   String @default("") // 원재료명
  allergyInfo   String @default("") // 알레르기 유발물질
  storageInfo   String @default("") // 보관방법
  expiryInfo    String @default("") // 소비기한
  nutritionInfo String @default("") // 영양성분

  sourceUrl String? // 벤더사(다나와/쿠팡 등) 원본 상품 URL — 이미지 임포트 출처 기록용

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  options     ProductOption[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  channelMaps ChannelProduct[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  isMain    Boolean @default(false)
  source    String  @default("upload") // "upload" | "import"
  sourceUrl String? // 임포트 원본 URL

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductOption {
  id         String  @id @default(cuid())
  productId  String
  name       String // 예: "선물세트 구성"
  value      String // 예: "재래김 10봉"
  extraPrice Int     @default(0)
  stock      Int     @default(0)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// ─────────────────────────────────────────────
// 장바구니 / 주문 / 결제
// ─────────────────────────────────────────────

model CartItem {
  id        String  @id @default(cuid())
  userId    String?
  guestKey  String? // 비회원 장바구니 (쿠키 키)
  productId String
  optionId  String?
  quantity  Int     @default(1)

  createdAt DateTime @default(now())

  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  ProductOption? @relation(fields: [optionId], references: [id])

  @@index([userId])
  @@index([guestKey])
}

model Order {
  id          String  @id @default(cuid())
  orderNo     String  @unique // 내부/PG 주문번호
  publicToken String  @unique @default(cuid()) // 비회원 완료 화면용 추측 불가능 토큰
  userId      String?

  // ── 판매 채널 (다채널 통합) ──
  channelCode    String  @default("SELF") // SELF | SMARTSTORE | COUPANG | ELEVENST | GMARKET | AUCTION | OFFLINE | ETC
  channelOrderNo String? // 채널이 부여한 주문번호
  // "{channelCode}:{channelOrderNo}" — 같은 주문을 두 번 가져오는 것을 막습니다
  externalKey    String? @unique
  channelRaw     String  @default("") // 원본 행/응답 (JSON 문자열, 문제 추적용)

  // 주문자
  ordererName  String
  ordererPhone String
  ordererEmail String @default("")

  // 배송지
  receiver  String
  recvPhone String
  zipcode   String
  address1  String
  address2  String @default("")
  memo      String @default("")

  // 금액
  itemTotal   Int // 상품 합계
  shippingFee Int @default(0)
  discount    Int @default(0)
  pointUsed   Int @default(0)
  totalAmount Int // 최종 결제 금액

  // 상태
  status String @default("PENDING")
  // PENDING(입금/결제대기) PAID(결제완료) PREPARING(상품준비중)
  // SHIPPING(배송중) DELIVERED(배송완료) CANCELLED(취소) REFUNDED(환불)

  // 배송
  courier     String? // 택배사
  trackingNo  String?
  shippedAt   DateTime?
  deliveredAt DateTime?

  // 주문 생성 시 재고를 예약하고, 결제/취소/환불을 멱등하게 정산합니다.
  stockReserved   Boolean   @default(false)
  rewardPoint     Int       @default(0)
  refundSettledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?       @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([channelCode])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  optionId  String?

  productName String // 주문 시점 스냅샷
  optionName  String @default("")
  imageUrl    String @default("")
  price       Int
  quantity    Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  option  ProductOption? @relation(fields: [optionId], references: [id])

  @@index([orderId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique

  method   String // "BANK"(무통장) | "TOSS" | "PORTONE"
  provider String @default("") // toss | portone
  status   String @default("READY") // READY | PAID | FAILED | CANCELLED | REFUNDED

  amount Int

  // PG 공통
  paymentKey  String? @unique // 토스 paymentKey — 다른 주문에 재사용 금지
  impUid      String? @unique // 포트원 imp_uid — 다른 주문에 재사용 금지
  merchantUid String? @unique // 포트원 merchant_uid
  receiptUrl  String?
  rawPayload  String  @default("") // 승인 응답 원문(JSON 문자열)

  // 무통장입금
  bankName    String?
  bankAccount String?
  depositor   String? // 입금자명
  depositedAt DateTime?

  paidAt      DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─────────────────────────────────────────────
// 콘텐츠 (회사소개 / 홍보)
// ─────────────────────────────────────────────

model History {
  id        String  @id @default(cuid())
  year      String // "2024"
  month     String  @default("") // "03"
  content   String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@index([year])
}

model Banner {
  id        String  @id @default(cuid())
  title     String
  subtitle  String  @default("")
  imageUrl  String
  linkUrl   String  @default("")
  position  String  @default("MAIN") // MAIN | SUB | POPUP
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  startAt DateTime?
  endAt   DateTime?

  createdAt DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  type      String   @default("NOTICE") // NOTICE | PRESS | FAQ
  title     String
  content   String
  isPinned  Boolean  @default(false)
  isActive  Boolean  @default(true)
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model Certification {
  id        String  @id @default(cuid())
  name      String // 예: HACCP 인증
  issuer    String  @default("")
  number    String  @default("")
  imageUrl  String?
  issuedAt  String  @default("")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Inquiry {
  id     String  @id @default(cuid())
  userId String?

  type    String @default("GENERAL") // GENERAL | ORDER | BULK(대량구매) | PARTNER
  name    String
  phone   String
  email   String @default("")
  company String @default("")
  title   String
  content String

  status     String    @default("OPEN") // OPEN | ANSWERED | CLOSED
  answer     String    @default("")
  answeredAt DateTime?

  agreePrivacy Boolean @default(true)

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
}

model Review {
  id          String  @id @default(cuid())
  productId   String
  userId      String
  orderItemId String? @unique

  rating   Int     @default(5)
  content  String
  imageUrl String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// 실시간 상담 (라이브챗)
// ─────────────────────────────────────────────

model ChatRoom {
  id         String  @id @default(cuid())
  visitorKey String  @unique // 비회원 식별 쿠키
  userId     String?

  name  String @default("고객")
  phone String @default("")
  email String @default("")

  status String @default("OPEN") // OPEN | ANSWERED | CLOSED
  topic  String @default("") // 첫 문의 요약

  unreadAdmin Int @default(0) // 관리자가 안 읽은 수
  unreadUser  Int @default(0) // 고객이 안 읽은 수

  lastMessage   String   @default("")
  lastMessageAt DateTime @default(now())

  // 방문 맥락 (상담원이 보면 유용)
  entryPath String @default("")
  userAgent String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([status])
  @@index([lastMessageAt])
}

model ChatMessage {
  id     String @id @default(cuid())
  roomId String

  sender  String // "USER" | "ADMIN" | "BOT"
  content String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

// ─────────────────────────────────────────────
// 해외 수출 / 판매 채널
// ─────────────────────────────────────────────

model ExportCountry {
  id     String @id @default(cuid())
  code   String @unique // ISO2 (KR, US, JP …)
  name   String // 한글 국가명
  nameEn String @default("")
  region String @default("ASIA") // ASIA | AMERICAS | EUROPE | OCEANIA | MEA

  // 지도 좌표 (자체 제작 SVG 세계지도 기준 0~100 비율)
  mapX Float @default(50)
  mapY Float @default(50)

  since   String @default("") // 수출 시작 연도
  partner String @default("") // 현지 파트너/유통사
  channel String @default("") // 유통 채널 설명
  note    String @default("")

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@index([region])
}

model SalesChannel {
  id        String  @id @default(cuid())
  name      String // 자사몰, 네이버 스마트스토어, 쿠팡, 대형마트, 급식/납품, 수출
  type      String  @default("ONLINE") // ONLINE | OFFLINE | EXPORT
  url       String  @default("")
  note      String  @default("")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

// ─────────────────────────────────────────────
// 다채널 통합 (오픈마켓 연동)
// ─────────────────────────────────────────────

model Channel {
  id        String  @id @default(cuid())
  code      String  @unique // SELF, SMARTSTORE, COUPANG, ELEVENST, GMARKET, AUCTION, OFFLINE, ETC
  name      String
  type      String  @default("OPENMARKET") // SELF | OPENMARKET | OFFLINE | EXPORT
  color     String  @default("#2a78d6")
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // 연동 방식
  syncMode String @default("MANUAL") // MANUAL(엑셀 업로드) | API
  adapter  String @default("") // "coupang" | "naver" | "" (없으면 CSV 전용)

  // 인증정보 — 의미는 어댑터마다 다릅니다
  //  쿠팡 : cred1=Access Key, cred2=Secret Key, cred3=업체코드(vendorId)
  //  네이버: cred1=Client ID,  cred2=Client Secret, cred3=(미사용)
  cred1 String @default("")
  cred2 String @default("")
  cred3 String @default("")

  autoSync       Boolean   @default(false) // 예약 동기화 사용 여부
  apiConnected   Boolean   @default(false) // 마지막 '연결 확인' 성공 여부
  lastSyncAt     DateTime?
  lastSyncStatus String    @default("") // OK | FAIL
  lastSyncNote   String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ChannelProduct[]
  logs     SyncLog[]
}

/**
 * 자사 상품 ↔ 채널 상품 매핑 (재고 동기화·주문 매칭에 사용)
 */
model ChannelProduct {
  id          String  @id @default(cuid())
  channelCode String
  productId   String
  optionId    String?

  externalProductId String // 채널 상품번호
  externalItemId    String @default("") // 채널 옵션(단품) 번호
  externalName      String @default("")
  externalSku       String @default("") // 판매자 상품코드 — CSV 매칭에 가장 자주 쓰입니다

  syncStock Boolean @default(true)
  syncPrice Boolean @default(false)

  lastPushedStock Int?
  lastPushedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelCode], references: [code], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([channelCode, externalProductId, externalItemId])
  @@index([productId])
  @@index([externalSku])
}

model SyncLog {
  id          String @id @default(cuid())
  channelCode String

  kind   String // ORDER_IMPORT | STOCK_PUSH | TEST
  source String @default("API") // API | CSV | MANUAL
  status String @default("OK") // OK | PARTIAL | FAIL

  imported Int @default(0)
  skipped  Int @default(0)
  failed   Int @default(0)

  message String @default("")
  detail  String @default("") // JSON 문자열

  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelCode], references: [code], onDelete: Cascade)

  @@index([channelCode, createdAt])
}

/**
 * 외부 솔루션(사방넷·이지어드민 등)이 자사몰을 읽어갈 때 쓰는 API 키
 */
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  key        String    @unique // SHA-256 hash only; 원문 키는 발급 직후 한 번만 표시
  prefix     String    @default("")
  scopes     String    @default("orders:read,products:read") // 콤마 구분
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  callCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

// ─────────────────────────────────────────────
// 알림톡 / 문자 발송
// ─────────────────────────────────────────────

/**
 * 발송 설정 (단일 행, id = "default")
 */
model MessageSetting {
  id       String @id @default("default")
  provider String @default("solapi") // solapi | none

  apiKey    String @default("")
  apiSecret String @default("")

  senderNumber String @default("") // 발신번호 (사전등록 필수)
  pfId         String @default("") // 카카오 비즈니스 채널 ID (KA01PF…)
  channelName  String @default("") // 채널 표시명 (@대천우정김)

  // 자동 발송 스위치
  autoOnPaid      Boolean @default(true) // 결제완료
  autoOnDeposit   Boolean @default(true) // 무통장 입금안내
  autoOnShipping  Boolean @default(true) // 발송(송장등록)
  autoOnDelivered Boolean @default(false) // 배송완료
  autoOnCancelled Boolean @default(true) // 취소

  // 광고 발송 정책 (법적 요건 — 함부로 끄지 마세요)
  adNightBlock Boolean @default(true) // 21시~08시 광고 차단
  adPrefix     String  @default("(광고)")
  adOptOutText String  @default("무료수신거부 ")
  adOptOutUrl  String  @default("") // 비우면 사이트 주소 + /unsubscribe 사용

  updatedAt DateTime @updatedAt
}

/**
 * 자동 발송 문구 템플릿
 */
model MessageTemplate {
  id   String @id @default(cuid())
  code String @unique // ORDER_PAID | DEPOSIT_WAIT | SHIPPING | DELIVERED | CANCELLED
  name String

  kakaoTemplateId String @default("") // 알림톡 템플릿 코드 (없으면 SMS 만 발송)
  smsText         String // 치환변수: #{이름} #{주문번호} #{상품명} #{금액} #{택배사} #{송장번호} #{조회링크}

  description String  @default("")
  isActive    Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/**
 * 발송 이력 (개별 건 단위)
 */
model MessageLog {
  id String @id @default(cuid())

  to   String
  name String @default("")
  type String @default("SMS") // SMS | LMS | ATA(알림톡) | CTA(친구톡)

  templateCode String?
  campaignId   String?
  orderId      String?
  userId       String?

  body String
  isAd Boolean @default(false)

  status        String @default("PENDING") // PENDING | SENT | FAILED | BLOCKED
  blockReason   String @default("") // 수신거부 / 야간 / 번호오류 등
  providerMsgId String @default("")
  errorCode     String @default("")
  errorMessage  String @default("")
  cost          Int    @default(0)

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([createdAt])
  @@index([to])
}

/**
 * 홍보 발송 (대량)
 */
model Campaign {
  id   String @id @default(cuid())
  name String
  type String @default("LMS") // SMS | LMS | ATA | CTA

  body     String
  imageUrl String  @default("")
  isAd     Boolean @default(true) // 홍보성이면 true — (광고) 표기와 야간차단이 걸립니다

  targetType   String @default("ALL") // ALL | GRADE | BUYER | NONBUYER | MANUAL | CUSTOM
  targetDetail String @default("") // 등급명 / 직접입력 번호목록 등

  scheduledAt DateTime?
  status      String    @default("DRAFT") // DRAFT | SCHEDULED | SENDING | DONE | FAILED

  total   Int @default(0)
  sent    Int @default(0)
  failed  Int @default(0)
  blocked Int @default(0)
  cost    Int @default(0)

  createdById String    @default("")
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  logs MessageLog[]

  @@index([status])
}

/**
 * 관리자 활동 기록 — 직원 계정을 여러 개 쓸 때 필요합니다
 */
model AdminLog {
  id       String @id @default(cuid())
  userId   String @default("")
  userName String @default("")

  action String // ORDER_CANCEL | STAFF_CREATE | MESSAGE_SEND | CHANNEL_CRED …
  target String @default("")
  detail String @default("")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/**
 * 마케팅 수신거부 토큰 (링크 클릭 한 번으로 처리)
 */
model OptOutToken {
  token     String    @id
  phone     String
  userId    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
}
