# ─── DB ─────────────────────────────────────────────
# 개발(SQLite). 운영 배포는 docs/PRODUCTION.md 의 PostgreSQL 절차를 따르세요.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ujgim?sslmode=require"

# ─── NextAuth ───────────────────────────────────────
# openssl rand -base64 32  로 생성
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 검색엔진 소유권 확인(선택)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""

# ─── 카카오 로그인 ───────────────────────────────────
# 고객 회원가입은 카카오/네이버로만 됩니다. 이 값이 비어 있으면 버튼이 안 나옵니다.
#
#  1. https://developers.kakao.com  로그인 → 내 애플리케이션 → 애플리케이션 추가하기
#  2. 앱 설정 > 플랫폼 > Web 플랫폼 등록 → 사이트 도메인: http://localhost:3000
#  3. 제품 설정 > 카카오 로그인 → 활성화 ON
#  4. 같은 화면 Redirect URI 등록 → http://localhost:3000/api/auth/callback/kakao
#  5. 동의항목에서 '닉네임' 필수, '카카오계정(이메일)' 선택 동의로 설정
#  6. 앱 설정 > 앱 키 의 [REST API 키]  →  AUTH_KAKAO_ID
#     ※ JavaScript 키/네이티브 키가 아니라 반드시 REST API 키입니다
#  7. 제품 설정 > 카카오 로그인 > 보안 에서 Client Secret 생성 → '사용함'으로 변경
#                                                    →  AUTH_KAKAO_SECRET
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# ─── 네이버 로그인 ───────────────────────────────────
#  1. https://developers.naver.com/apps/#/register  → 애플리케이션 등록
#  2. 사용 API: '네이버 로그인' / 제공 정보: 이름·이메일 체크
#  3. 환경 추가: 'PC 웹' → 서비스 URL: http://localhost:3000
#  4. Callback URL: http://localhost:3000/api/auth/callback/naver
#  5. 등록 후 Client ID → AUTH_NAVER_ID / Client Secret → AUTH_NAVER_SECRET
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# ※ 키를 넣은 뒤에는 개발 서버를 반드시 껐다 켜세요 (Ctrl+C → npm run dev).
#    Next.js 는 시작할 때 한 번만 .env 를 읽습니다.
# ※ 실제 도메인으로 배포할 때는 위 콜백 주소를 그 도메인으로도 추가 등록해야 합니다.

# ─── 토스페이먼츠 ───────────────────────────────────
# https://developers.tosspayments.com
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# ─── 포트원(아임포트) ────────────────────────────────
# https://admin.portone.io  → 결제연동 / 내 식별코드·API Keys
NEXT_PUBLIC_PORTONE_IMP_CODE="imp00000000"
PORTONE_API_KEY=""
PORTONE_API_SECRET=""
# 포트원 PG 상점아이디 (예: html5_inicis.INIpayTest / kakaopay.TC0ONETIME)
NEXT_PUBLIC_PORTONE_PG="html5_inicis.INIpayTest"

# ─── 무통장입금 계좌 ─────────────────────────────────
BANK_NAME="농협은행"
BANK_ACCOUNT="301-0000-0000-00"
BANK_HOLDER="(주)대천우정김"

# ─── 관리자 초기 계정 (seed) ─────────────────────────
# 관리자 로그인 아이디. 공개 저장소에서도 아이디만 기본값으로 사용합니다.
ADMIN_USERNAME="admin"
ADMIN_EMAIL=""
# 비밀번호는 공개 저장소에 적지 말고 배포 서비스의 Secret/Environment Variable에 넣으세요.
# 12자 이상, 영문 대/소문자·숫자·특수문자를 조합해야 합니다.
ADMIN_PASSWORD=""

# ─── 예약 주문 자동 취소 Cron ─────────────────────────
# openssl rand -base64 32
CRON_SECRET=""

# 판매채널 API 인증정보 AES-256 암호화 키 (운영 필수, 변경 시 기존 인증정보 복호화 불가)
# openssl rand -base64 32
CHANNEL_CREDENTIAL_KEY=""

# 관리자 상품 URL 가져오기에 추가로 허용할 HTTPS 도메인(쉼표 구분)
IMPORT_ALLOWED_HOSTS=""

# 영속 디스크가 있는 단일 서버에서만 true. Vercel/서버리스는 객체 스토리지 구현을 사용하세요.
ALLOW_LOCAL_UPLOADS="false"
