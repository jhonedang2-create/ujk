{
  "name": "ujgim",
  "version": "1.0.0",
  "private": true,
  "description": "(주)대천우정김 공식 홈페이지 + 자사몰 + 관리자",
  "engines": { "node": ">=20.0.0" },
  "overrides": {
    "postcss": "8.5.26",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.20.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:postgres": "prisma generate --schema prisma/postgresql/schema.prisma && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:deploy:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:seed:postgres": "prisma generate --schema prisma/postgresql/schema.prisma && node --import tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && npm run db:seed"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "6.19.1",
    "bcryptjs": "^2.4.3",
    "next": "15.5.24",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "sanitize-html": "2.17.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "2.16.1",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.26",
    "prisma": "6.19.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
